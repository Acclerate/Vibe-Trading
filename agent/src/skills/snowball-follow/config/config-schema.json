{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Snowball Follow Config",
  "type": "object",
  "required": ["language", "timezone", "frequency", "delivery"],
  "properties": {
    "language": {
      "type": "string",
      "enum": ["zh"],
      "default": "zh",
      "description": "摘要语言"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Shanghai",
      "description": "用户时区"
    },
    "frequency": {
      "type": "string",
      "enum": ["daily", "weekly"],
      "default": "daily",
      "description": "推送频率"
    },
    "deliveryTime": {
      "type": "string",
      "default": "08:00",
      "description": "每日推送时间 HH:MM"
    },
    "weeklyDay": {
      "type": "string",
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "default": "monday",
      "description": "周报推送日"
    },
    "delivery": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["feishu-doc", "stdout"],
          "default": "feishu-doc",
          "description": "推送方式"
        },
        "folderToken": {
          "type": "string",
          "description": "飞书目标文件夹 token（feishu-doc 模式必填）"
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "大V列表（可选，覆盖默认列表）",
      "items": {
        "type": "object",
        "required": ["name", "slug"],
        "properties": {
          "name": { "type": "string", "description": "雪球用户名" },
          "slug": { "type": "string", "description": "雪球用户主页标识，可为字母别名或数字ID" },
          "tag": { "type": "string", "description": "用户标签/领域" }
        }
      }
    },
    "lookbackHours": {
      "type": "number",
      "default": 24,
      "description": "回溯时间窗口（小时）"
    },
    "maxPostsPerAuthor": {
      "type": "number",
      "default": 5,
      "description": "每位大V最多抓取帖子数"
    },
    "onboardingComplete": {
      "type": "boolean",
      "default": false
    }
  }
}
